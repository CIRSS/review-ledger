#!/usr/bin/env node
// Records which files a person has reviewed, and reports what has changed since.
//
//     reviews record <path>...        record a cursory review of files as they stand
//         --careful                   record a careful one instead
//         --formal                    record a formal one, which needs evidence
//         --evidence <artifact>       name what records the review, at any level
//     reviews declare <path> <origin> record how a file's content came to exist
//     reviews show [--stale]          the report

'use strict';

const { execFileSync } = require('child_process');
const fs = require('fs');
const path = require('path');

// What a row shows, as four columns: whose file it is, then whether anyone
// looked, what they concluded, and whether a protocol was followed. A review
// fills the last three from the left and its strength reads as how far it gets;
// anything that is not a review has nothing to say about looking, so it starts
// at the verdict and every verdict — ✅ ❌ ⚠️ — reads down one column.
//
// Origin holds a column of its own because it answers a different question. It
// used to occupy the verdict column, where a single review of a vendored file
// erased the fact that the file was never ours to review.
//
// Markdown gets four table columns and aligns them itself, which is why no
// filler is needed: every blank is a real empty cell.
const ORIGIN_MARKS = { vendor: '⚙️', generated: '🛠️', human: '✍️', authored: '' };

const DISPLAY = {
    'current:cursory': { marks: ['👀', '', ''], label: 'reviewed cursorily, and unchanged since' },
    'current:careful': { marks: ['👀', '✅', ''], label: 'reviewed carefully, and unchanged since' },
    'current:formal': { marks: ['👀', '✅', '🔬'], label: 'formally reviewed, and unchanged since' },
    'current:none': { marks: ['', '❔', ''], label: 'reviewed, type not recorded' },
    drifted: { marks: ['', '⚠️', ''], label: 'reviewed earlier; changed since' },
    unread: { marks: ['', '❌', ''], label: 'no review recorded' },
    // A file that is not ours wants no reviewer, so it shows its origin and
    // makes no claim in the other three columns.
    vendor: { marks: ['', '', ''], label: 'vendored files unreviewed; not ours to review' },
    generated: { marks: ['', '', ''], label: 'generated files unreviewed; review the generator' },
    // A file a person wrote wants no reviewer either, but for the opposite
    // reason, so it says so in the verdict column: 🟢 is clear, where ✅ is
    // checked. No review is recorded and none is missing.
    human: { marks: ['', '🟢', ''], label: 'written by a person; reviewed by definition' },
};

// The level a review still supports. A formal review whose record has gone is
// a careful one: the reading happened, the protocol may have happened, but
// nothing a reader can reach says so any more. Everything that shows or counts
// a review goes through here, so no two parts of the report can disagree.
const shownKey = (row) => {
    const key = displayOf(row);
    if (key === 'current:formal' && row.lost) return 'current:careful';
    // A glance is not what makes a file a person wrote clear — the person who
    // wrote it is, and it was clear before anyone looked. So a cursory review
    // of one lands at careful rather than below it, and its 👀 ✅ is the line
    // the summary counts it on. A formal review still stands as formal: it
    // names a record, which is more than the declaration ever said.
    if (row.origin === 'human' && row.state === 'current' && key !== 'current:formal') {
        return 'current:careful';
    }
    return key;
};

// The review level a row still supports, for prose that names what was done:
// null where nothing was recorded, or where the record predates types. It
// carries shownKey's lost-evidence downgrade — a formal review whose record has
// gone cannot go on calling itself formal — but not shownKey's human-origin
// promotion, which is a claim about the file rather than about the reading. The
// columns say how a file stands; this says what somebody did to it, and a
// cursory review of a file a person wrote was still a cursory review.
const levelOf = (row) => {
    if (!row.reading || !row.reading.type) return null;
    return row.reading.type === 'formal' && row.lost ? 'careful' : row.reading.type;
};

// A file a person wrote never wants a reviewer, so 🟢 stands until somebody
// reads it: editing one does not make it want re-reading, and a review that has
// drifted leaves it exactly as settled as it was. A current review says more
// than the origin does, and shownKey has already put its ✅ in the column.
const marksOf = (row) => {
    const marks = [ORIGIN_MARKS[row.origin] || '', ...DISPLAY[shownKey(row)].marks];
    if (row.origin === 'human' && row.state !== 'current') marks[2] = '🟢';
    return marks;
};

const cellsOf = (marks) => marks.map((mark) => ` ${mark} `).join('|');

// A column no row uses says nothing and costs a visible cell in every line, so
// it is left out. The columns that remain keep their order and their meaning.
const usedColumns = (everyMarks) => [0, 1, 2, 3]
    .filter((column) => everyMarks.some((marks) => marks[column]));
const keep = (columns) => (marks) => columns.map((column) => marks[column]);
const iconOf = (marks) => marks.filter(Boolean).join('');

// Every record written since types existed carries one, so an absent type marks
// a record that predates them rather than one claiming the weakest level.
const displayOf = (row) => (row.state === 'current'
    ? `current:${row.reading.type || 'none'}`
    : row.state);

// Icons are measured in terminal cells, not characters: these render
// double-width, and a variation selector makes some of them two UTF-16 units,
// so neither string length nor glyph count locates a column.
const cells = (icon) => [...new Intl.Segmenter().segment(icon)]
    .reduce((n, { segment }) => n + (/\p{Extended_Pictographic}/u.test(segment) ? 2 : 1), 0);

// vendor is content copied in unaltered from elsewhere — a framework's own
// files, a pinned ontology, a vendored schema. What guards such a file is the
// hash beside it, not a reading: on a byte copy an edit is a defect.
const ORIGINS = ['authored', 'generated', 'vendor', 'human'];
const TYPES = ['cursory', 'careful', 'formal'];

function fail(message) {
    process.stderr.write(`reviews: ${message}\n`);
    process.exit(2);
}

function git(args, options = {}) {
    return execFileSync('git', args,
        { cwd: REPO, encoding: 'utf8', stdio: ['pipe', 'pipe', 'pipe'], ...options }).trim();
}

const REPO = (() => {
    try {
        return execFileSync('git', ['rev-parse', '--show-toplevel'],
            { encoding: 'utf8', stdio: ['pipe', 'pipe', 'pipe'] }).trim();
    } catch {
        fail('not inside a git repository');
    }
})();

// The log lives in this module's trim directory. A repository's root is for
// what its readers open; the log is written and read by the command.
const LOG = process.env.REVIEWS_LOG || path.join(REPO, '.review-ledger', 'reviews.jsonl');

// null in a repository with no commits, which is where a first report is run.
function headCommit() {
    try {
        return git(['rev-parse', 'HEAD']);
    } catch {
        return null;
    }
}

// Returns the log's records in the order they were appended.
function readLog() {
    if (!fs.existsSync(LOG)) return [];
    return fs.readFileSync(LOG, 'utf8').split('\n').filter(Boolean).map((line, index) => {
        try {
            return JSON.parse(line);
        } catch {
            fail(`${LOG} line ${index + 1} is not valid JSON`);
        }
    });
}

function append(record) {
    // The trim directory exists once the REPRO has been started, and not before.
    fs.mkdirSync(path.dirname(LOG), { recursive: true });
    fs.appendFileSync(LOG, `${JSON.stringify(record)}\n`);
}

// Where the log sits relative to the repository, which is what git wants and
// what a message should print.
const logPath = () => path.relative(REPO, LOG);

// What is ignoring the log, or null if nothing is.
//
// The two forms answer different questions and only one of them is the test.
// `-q` exits 0 when the path is ignored. `-v` reports every pattern that
// matches, negations included, and exits 0 for those too — so a path made
// visible by a `!` rule is a match, and using -v as the boolean calls it
// ignored. Ask -q first, then -v only to say what is responsible, which is the
// difference between a message a reader can act on and one that says only that
// something is wrong.
function ignoredBy() {
    try {
        git(['check-ignore', '-q', logPath()]);
    } catch {
        // Exit 1 means not ignored. Any other failure — no git, a path outside
        // the repository — is not this check's to diagnose.
        return null;
    }
    // "<source>:<line>:<pattern>\t<pathname>", and a pattern may contain a colon.
    const parts = git(['check-ignore', '-v', logPath()]).split('\t')[0].split(':');
    return { source: parts[0], line: parts[1], pattern: parts.slice(2).join(':') };
}

// The design rests on the log being committed beside the report: the report can
// afford to describe only the present because the log holds the past. A log git
// never sees breaks that quietly, and only at the first fresh clone, by which
// time the readings it held are gone for good.
function refuseIfIgnored() {
    const ignored = ignoredBy();
    if (!ignored) return;
    const said = `${logPath()} is ignored by ${ignored.source}:${ignored.line} `
        + `(${ignored.pattern})\n`
        + '  A review log git never sees is a record nobody else will ever read.';
    // Offer the fix to whoever can answer. Without a terminal there is nobody
    // to ask — this runs under make, in scripts, in CI — and a question nobody
    // can answer is worse than a message.
    if (process.stdin.isTTY) {
        if (ask(`reviews: ${said}\n  Make it trackable now? [y/N] `)) {
            track();
            return;
        }
        // The diagnosis was just on screen and just declined; repeating it says
        // nothing the reader does not have.
        fail('nothing recorded. Run `reviews track` when you want the log kept.');
    }
    fail(`${said}\n  Run \`reviews track\` to make it trackable, or edit that file yourself.`);
}

// One line from the terminal, true only on an explicit yes. Declining refuses
// the write rather than proceeding into a log that will not be kept: someone
// who wants an untracked log has REVIEWS_LOG and their own .gitignore, and
// nothing here is silent once the question has been asked.
//
// The question goes to stderr, where the diagnosis goes, so that redirecting
// stdout still captures only what the command was asked to produce.
//
// The answer is read from /dev/tty rather than from fd 0. Reading fd 0 with
// readSync throws EAGAIN whenever a whole line is not already buffered, which
// is the normal case when a person has yet to type — so the prompt would print
// and decline in the same breath. A descriptor opened on the terminal blocks,
// which is what asking a question requires.
//
// The terminal is in canonical mode, so the answer arrives on Enter. That is
// worth keeping: a single keypress would need raw mode, where Ctrl-C stops
// being an interrupt and a mistyped answer cannot be taken back.
function ask(question) {
    let terminal;
    try {
        terminal = fs.openSync('/dev/tty', 'rs');
    } catch {
        return false;
    }
    try {
        process.stderr.write(question);
        const buffer = Buffer.alloc(64);
        const read = fs.readSync(terminal, buffer, 0, buffer.length, null);
        return ['y', 'yes'].includes(buffer.toString('utf8', 0, read).trim().toLowerCase());
    } catch {
        return false;
    } finally {
        fs.closeSync(terminal);
    }
}

// Makes the log visible to git, and then checks rather than assumes.
//
// gitignore has enough traps to make a generated edit worth verifying: a
// negation under an excluded parent directory does nothing at all, patterns
// match dotfiles, and the deepest file wins. So each candidate edit is applied
// and then put to `check-ignore` again, and anything that did not work is
// reverted rather than reported as a fix.
//
// It never stages the log. Which files go into a commit is the committer's
// choice to make, and a tool that writes to the index takes it away.
function track() {
    if (!ignoredBy()) {
        console.log(`${logPath()} is already visible to git.`);
        return;
    }

    const log = logPath();
    const dir = path.dirname(log);
    // Two edits, tried in order. The first is enough when a pattern matches the
    // log itself; the second is needed when a parent directory is excluded,
    // since git does not descend into one and never reads a negation inside it.
    const edits = [[[path.join(REPO, '.gitignore'), [`!${log}`]]]];
    if (dir !== '.') {
        edits.push([
            [path.join(REPO, '.gitignore'), [`!${dir}/`]],
            // `*` matches dotfiles, so the exception list must except itself or
            // it is never committed, and a fresh clone ignores the log again.
            [path.join(REPO, dir, '.gitignore'), ['*', '!.gitignore', `!${path.basename(log)}`]],
        ]);
    }

    for (const edit of edits) {
        const undo = edit.map(([file]) => [file, fs.existsSync(file) ? fs.readFileSync(file, 'utf8') : null]);
        for (const [file, lines] of edit) {
            const before = fs.existsSync(file) ? fs.readFileSync(file, 'utf8') : '';
            const missing = lines.filter((line) => !before.split('\n').includes(line));
            if (!missing.length) continue;
            fs.writeFileSync(file, `${before}${before && !before.endsWith('\n') ? '\n' : ''}${missing.join('\n')}\n`);
        }
        if (!ignoredBy()) {
            for (const [file] of edit) console.log(`${path.relative(REPO, file)}: updated`);
            console.log(`${log} is now visible to git.`);
            return;
        }
        for (const [file, contents] of undo) {
            if (contents === null) fs.unlinkSync(file); else fs.writeFileSync(file, contents);
        }
    }

    const ignored = ignoredBy();
    fail(`could not make ${log} visible to git; ${ignored.source}:${ignored.line} `
        + `(${ignored.pattern}) still ignores it.\n`
        + '  Nothing was changed. Edit that file by hand.');
}

// The paths git sees: tracked, plus untracked ones that are not ignored, minus
// anything no longer on disk, which --cached still lists until the deletion is
// staged.
function filesGitSees() {
    // An unmerged path is listed once per stage, so the set collapses a
    // conflicted file back to the one row it should have.
    const listed = git(['ls-files', '--cached', '--others', '--exclude-standard'])
        .split('\n').filter(Boolean);
    return [...new Set(listed)]
        .filter((file) => fs.existsSync(path.join(REPO, file)));
}

// Every path this file has had, so a reading recorded before a rename still
// counts. --follow reports the renames git can detect.
function pathHistory(file) {
    try {
        const names = git(['log', '--follow', '--name-only', '--format=', '--', file]);
        return new Set([file, ...names.split('\n').filter(Boolean)]);
    } catch {
        return new Set([file]);
    }
}

// How much a file has changed since it was read, as [added, deleted], null if
// it has not, or 'gone' if what was read is no longer in the object store.
// Comparing blobs rather than paths means a file that has only moved compares
// equal.
function changeSince(wasRead, file) {
    if (!wasRead) return 'gone';
    // -w stores the object, without which the diff below has nothing to read.
    const now = git(['hash-object', '-w', file]);
    if (wasRead === now) return null;

    try {
        const numstat = git(['diff', '--numstat', wasRead, now]);
        const [added, deleted] = numstat.split('\t').map(Number);
        return [added, deleted];
    } catch {
        return 'gone';
    }
}

// The commit that introduced this content, or null if none does. Asked afresh
// on every run, because a stored answer goes stale in both directions: content
// committed after it was reviewed, and a commit orphaned by an amend or rebase.
function commitFor(blob) {
    if (!blob) return null;
    try {
        const found = git(['log', '--format=%H', '--find-object', blob]);
        const commits = found.split('\n').filter(Boolean);
        // git log is newest first, so the commit that introduced it is the last.
        return commits.length ? commits[commits.length - 1] : null;
    } catch {
        return null;
    }
}

// What a review was of. Records written before reviews were anchored to
// blobs name a commit and a path instead, which resolve to the same thing.
function blobRead(reading) {
    if (reading.blob) return reading.blob;
    try {
        return git(['rev-parse', `${reading.commit}:${reading.path}`]);
    } catch {
        return null;
    }
}

// What became of a review's evidence, or null if it is still there. A formal
// review is defined as one that names the record of itself, so when that record
// goes the review no longer meets the definition and the report stops claiming
// it does. The log still says what was claimed at the time.
function evidenceLost(reading) {
    const evidence = reading && reading.evidence;
    if (!evidence) return null;
    if (!fs.existsSync(path.join(REPO, evidence.path))) return 'no longer in the repository';
    try {
        git(['cat-file', '-e', evidence.blob]);
    } catch {
        return 'that version is gone';
    }
    return null;
}

function statusOf(file, log) {
    // Both an origin and a review follow the file across renames. Matching an
    // origin on the exact path alone would silently drop a declaration the
    // moment the file moved.
    const history = pathHistory(file);
    const declared = log.filter((r) => r.kind === 'origin' && history.has(r.path)).pop();
    const origin = declared ? declared.origin : 'authored';

    const reading = log.filter((r) => r.kind === 'review' && history.has(r.path)).pop();

    if (!reading) {
        // Origin decides only whether a reviewer is wanted, never what a review
        // said; it keeps its own column either way.
        if (origin === 'vendor') return { state: 'vendor', origin };
        if (origin === 'generated') return { state: 'generated', origin, declared };
        if (origin === 'human') return { state: 'human', origin, declared };
        return { state: 'unread', origin };
    }

    const lost = evidenceLost(reading);
    const change = changeSince(blobRead(reading), file);
    return change
        ? { state: 'drifted', origin, reading, change, lost }
        : { state: 'current', origin, reading, lost };
}

// Each directory shows its own files first, then its subdirectory trees, so a
// reader meets a directory's contents before descending. Names are compared
// without regard to case: GitHub's own listing is case-sensitive and puts every
// capital above every lowercase name, which reads as arbitrary.
function byTreeOrder(a, b) {
    const left = a.split('/');
    const right = b.split('/');
    for (let i = 0; i < Math.min(left.length, right.length); i += 1) {
        const leftEnds = i === left.length - 1;
        const rightEnds = i === right.length - 1;
        // Where one path ends and the other goes deeper, the file in this
        // directory comes before anything inside a subdirectory of it.
        if (leftEnds !== rightEnds) return leftEnds ? -1 : 1;
        const here = left[i].toLowerCase();
        const there = right[i].toLowerCase();
        if (here !== there) return here < there ? -1 : 1;
    }
    return 0;
}

function rows(log) {
    return filesGitSees().sort(byTreeOrder)
        .map((file) => ({ file, ...statusOf(file, log) }));
}

// --- subcommands ------------------------------------------------------------

function record(paths, by, type, evidencePath) {
    refuseIfIgnored();
    if (!paths.length) fail('reviews record needs at least one path');
    if (!TYPES.includes(type)) fail(`review type must be one of ${TYPES.join(', ')}`);
    // Any review may name what records it; a formal one must. That is the whole
    // of what makes the top level checkable rather than merely asserted, and a
    // flag that raised the claim without adding anything would have made it the
    // easiest thing on the scale to say.
    if (type === 'formal' && !evidencePath) {
        fail('a formal review names what records it: --formal --evidence <artifact>');
    }
    if (evidencePath) {
        if (!fs.existsSync(path.join(REPO, evidencePath))) fail(`no such file: ${evidencePath}`);
        // Evidence has to travel with the repository. A file git cannot see
        // reaches no other clone, so it can back a claim for its author and
        // nobody else, which is the one thing this level is for.
        if (!filesGitSees().includes(evidencePath)) {
            fail(`git does not carry ${evidencePath}: evidence nobody else receives is not evidence`);
        }
    }
    // Who reviewed it is a fact about the person, not the repository or the
    // image, so it comes from what they brought: REVIEWS_BY first, since a
    // container usually has no git identity, then git's own.
    //
    // git exits non-zero when the key is unset rather than printing nothing, so
    // the throw has to be caught or the sentence below never runs and the
    // reviewer is told "Command failed: git config user.name" instead.
    const configured = () => {
        try {
            return git(['config', 'user.name']);
        } catch {
            return null;
        }
    };
    const reader = by || process.env.REVIEWS_BY || configured();
    if (!reader) fail('no reviewer: set REVIEWS_BY or git config user.name, or pass --by NAME');

    // Every path is checked before any record is written: a partly written
    // command would leave an append-only log holding half of what was asked.
    for (const file of paths) {
        if (!fs.existsSync(path.join(REPO, file))) fail(`no such file: ${file}`);
    }

    const date = new Date().toISOString().slice(0, 10);
    for (const file of paths) {
        // The blob is what was reviewed, and -w keeps it readable afterwards.
        // It exists whether or not the file has ever been committed. No commit
        // is stored: where the content sits is asked afresh at report time.
        const blob = git(['hash-object', '-w', file]);
        // The evidence is pinned the same way the reviewed file is, so it names
        // the version that existed when the review was recorded.
        const evidence = evidencePath
            ? { path: evidencePath, blob: git(['hash-object', '-w', evidencePath]) }
            : undefined;
        append({ kind: 'review', path: file, blob, by: reader, date, type, evidence });
        console.log(`${file}: ${type} review by ${reader} (${blob.slice(0, 7)})`
            + (evidence ? ` per ${evidence.path}` : ''));
    }
}

function declare(file, origin) {
    refuseIfIgnored();
    if (!ORIGINS.includes(origin)) {
        fail(`origin must be one of ${ORIGINS.join(', ')}`);
    }
    append({ kind: 'origin', path: file, origin });
    console.log(`${file}: ${origin}`);
}

function show(onlyStale) {
    // A note, not a refusal: reading is harmless, and failing here would block
    // the one command that might explain what is wrong. stderr keeps the report
    // on stdout exactly the report, so a redirect still writes a clean file.
    const ignored = ignoredBy();
    if (ignored) {
        process.stderr.write(`reviews: ${logPath()} is ignored by ${ignored.source}:`
            + `${ignored.line} (${ignored.pattern}); run \`reviews track\`\n`);
    }
    const log = readLog();
    const all = rows(log);
    // Two tallies, not one partition. Review state and origin are independent —
    // a vendored file someone reviewed anyway belongs to both — so counting
    // every file once would have to drop it from one of them, and it did: the
    // review won and the vendor count went short.
    const counts = {};
    const totals = {};
    const tally = (of, key) => { of[key] = (of[key] || 0) + 1; };
    // The summary counts what the row shows, so the two cannot disagree: a
    // human-written file counts as human exactly while its verdict mark is 🟢,
    // and counts with the reviewed once somebody has read it.
    const countKey = (row) => {
        const key = shownKey(row);
        return marksOf(row)[2] === '🟢' ? 'human' : key;
    };
    for (const row of all) {
        const key = countKey(row);
        if (!['vendor', 'generated'].includes(key)) tally(counts, key);
        // Origin counts every file that carries it, so the tally matches the
        // column. The summary reads as a heads-up of what is left to do, so the
        // number shown is what still wants nothing done — the unreviewed ones —
        // and the total goes in the line beside it rather than being lost.
        for (const [state, origin] of [['vendor', 'vendor'], ['generated', 'generated']]) {
            if (row.origin !== origin) continue;
            tally(totals, state);
            if (key === state) tally(counts, state);
        }
    }
    const labelFor = (key, entry) => (totals[key] && key !== 'human'
        ? `of ${totals[key]} ${entry.label}`
        : entry.label);

    // What wants a reviewer is what the verdict column says wants one, so a
    // human file stays off this list however much it has been edited.
    const wanted = onlyStale
        ? all.filter((row) => ['unread', 'drifted'].includes(countKey(row)))
        : all;

    // A commit is the only identifier a reader of the committed report can
    // resolve: GitHub has no route for a blob hash. Where none exists, the row
    // names nothing rather than offering something unusable.
    // A drifted row loses its type from the icon columns — ⚠️ sits in the same
    // column as ✅ — so naming the level here is the only place the report can
    // say whether what has gone stale was a glance or an inspection, which is
    // the difference between rereading a file and taking it on trust.
    // A record from before types were kept says nothing rather than guessing.
    const at = (row) => {
        const level = levelOf(row);
        const commit = commitFor(blobRead(row.reading));
        if (!level) return commit ? `since ${commit.slice(0, 7)}` : 'since it was reviewed';
        return commit
            ? `since ${level} review at ${commit.slice(0, 7)}`
            : `since a ${level} review`;
    };
    // What the evidence of a formal review is worth: where it stands itself, and
    // whether the version named still exists at all.
    // Only whether the evidence is still there. Its own review state is not
    // shown: an inspection record is written by the person doing the inspecting,
    // so nobody reviewing it is the ordinary case, and a ❌ beside it would
    // report a gap where there is none.
    //
    // It can go two ways, and both leave the review resting on nothing. The
    // file can be deleted, which is the common one, or the version pinned can
    // leave the object store while the file stays.
    // Named only while it is there to be read. Evidence that has gone is not
    // reported as gone: the mark has already fallen to what the review still
    // supports, and a path to nothing helps nobody.
    const per = (row) => {
        const evidence = row.reading && row.reading.evidence;
        return evidence && !row.lost ? `, per ${evidence.path}` : '';
    };
    const since = (row) => {
        if (row.state === 'current') return `unchanged ${at(row)}${per(row)}`;
        if (row.state !== 'drifted') return '';
        return row.change === 'gone'
            ? 'reviewed at a version no longer in the repository'
            : `+${row.change[0]} −${row.change[1]} ${at(row)}${per(row)}`;
    };
    const reader = (row) => (row.reading ? `${row.reading.by}, ${row.reading.date}` : '');

    const shown = Object.entries(DISPLAY).filter(([key]) => counts[key]);
    const ORIGIN_OF_STATE = { vendor: 'vendor', generated: 'generated', human: 'human' };
    const legendMarks = (key, entry) => (ORIGIN_OF_STATE[key]
        ? [ORIGIN_MARKS[ORIGIN_OF_STATE[key]], ...entry.marks]
        : ['', ...entry.marks]);
    // Both renderings use the same columns, so the two agree about what a
    // report of this repository looks like.
    const columns = usedColumns([
        ...wanted.map(marksOf),
        ...shown.map(([key, entry]) => legendMarks(key, entry)),
    ]);
    const used = keep(columns);

    // Both renderings name the two sections with the same words, so a reader
    // who has met one recognizes the other. --stale lists a subset and counts a
    // population that subset does not show, so each heading says which of the
    // two it is describing.
    const summaryHeading = onlyStale ? 'Whole repository' : 'Summary';
    const filesHeading = onlyStale ? 'Files wanting a reviewer' : 'All files';

    // The two renderings put the summary at opposite ends for the same reason.
    // A terminal scrolls, so what is on screen when the prompt returns is the
    // last thing printed and the file list has gone by; a file does not, so
    // what is on screen is the first. Either way the summary is where the eye
    // lands and the list is what a reader scrolls to.
    if (process.stdout.isTTY) {
        const widest = (of) => Math.max(0, ...all.map((row) => of(row).length));
        const fileWidth = widest((row) => row.file);
        const readerWidth = widest(reader);
        // The table and the legend size themselves separately. --stale lists no
        // formal review, so its table should not reserve a third icon column
        // that stays blank; the legend counts every row and so still needs one.
        // At a terminal the three columns are laid out by hand: each mark takes
        // its own fixed width, so a blank one leaves a gap of the same size.
        const marked = (marks) => used(marks)
            .map((mark) => mark + ' '.repeat(2 - cells(mark)))
            .join(' ').trimEnd();
        const iconWidth = columns.length * 3 - 1;
        const padMarks = (marks) => marked(marks) + ' '.repeat(iconWidth - cells(marked(marks)));
        // Headings, because the marks in the tally are a legend and the same
        // marks in the table are findings. Unlabelled, the two blocks read as
        // one list and a ❌ explaining a count is taken for a file in trouble.
        console.log();
        console.log(`  ${filesHeading}`);
        console.log();
        for (const row of wanted) {
            console.log(`  ${padMarks(marksOf(row))}  ${row.file.padEnd(fileWidth)}  `
                + `${reader(row).padEnd(readerWidth)}  ${since(row)}`.trimEnd());
        }
        console.log();
        console.log(`  ${summaryHeading}`);
        console.log();
        let origins = false;
        for (const [key, entry] of shown) {
            const isOrigin = key === 'vendor' || key === 'generated';
            // A blank line where the tally changes subject, so the counts are
            // not read as parts of one whole.
            if (isOrigin && !origins) { console.log(); origins = true; }
            console.log(`  ${padMarks(legendMarks(key, entry))} `
                + `${String(counts[key]).padStart(3)}  `
                + labelFor(key, entry));
        }
        console.log();
        return;
    }

    const lines = ['# Repository review status', ''];
    const head = headCommit();
    lines.push(head
        // "at commit" invited the reading that this file lives in that commit.
        // It does not: committing the report moves HEAD, so the commit carrying
        // it is always the next one. The sha names the state described.
        ? `*Generated by \`reviews show\` with HEAD at \`${head.slice(0, 7)}\`. `
          + 'Rerun it to bring this up to date.*'
        : '*Generated by `reviews show` before this repository had any commits.*', '');
    const blanks = columns.map(() => '').join(' | ');
    const rules = columns.map(() => '---').join(' | ');

    // The summary leads. It is a handful of lines and answers the question a
    // reader arrives with — how much of this wants attention — where the file
    // table can run to hundreds of rows and bury it.
    lines.push(`## ${summaryHeading}`, '');
    lines.push(`| ${blanks} | Files | Meaning |`, `| ${rules} | ---: | --- |`);
    for (const [key, entry] of shown) {
        lines.push(`|${cellsOf(used(legendMarks(key, entry)))}| ${counts[key]} `
            + `| ${labelFor(key, entry)} |`);
    }
    lines.push('', '❌ means no review has been *recorded*, which is not the same as nobody '
        + 'having reviewed the file.', '');

    lines.push(`## ${filesHeading}`, '');
    lines.push(`| ${blanks} | File | Reviewed by (dates UTC) | Since |`,
        `| ${rules} | --- | --- | --- |`);
    for (const row of wanted) {
        lines.push(`|${cellsOf(used(marksOf(row)))}| \`${row.file}\` `
            + `| ${reader(row)} | ${since(row)} |`);
    }
    process.stdout.write(`${lines.join('\n')}\n`);
}

// --- dispatch ---------------------------------------------------------------

// Anything unexpected is reported as a message. A stack trace tells a reader
// nothing they can act on, and an uncaught throw exits 1, which is a verdict.
process.on('uncaughtException', (error) => fail(error.message.split('\n')[0]));

const [subcommand, ...rest] = process.argv.slice(2);
const flag = (name, { required = false } = {}) => {
    const at = rest.indexOf(name);
    if (at === -1) return null;
    const [, value] = rest.splice(at, 2);
    if (required && (!value || value.startsWith('-'))) fail(`${name} needs an argument`);
    return value;
};

if (subcommand === 'record') {
    // flag() splices its argument out of rest, so it has to run before the
    // paths are read off; as one call's arguments it would run second.
    const by = flag('--by');
    const evidence = flag('--evidence', { required: true });
    // The default is the weakest claim: the cheapest thing to record has to be
    // the honest one, or the pressure is to overclaim.
    const named = TYPES.filter((name) => rest.includes(`--${name}`));
    if (named.length > 1) fail('give one review type, not two');
    record(rest.filter((argument) => !argument.startsWith('-')), by,
        named[0] || 'cursory', evidence);
} else if (subcommand === 'declare') {
    declare(rest[0], rest[1]);
} else if (subcommand === 'track') {
    track();
} else if (subcommand === 'show') {
    show(rest.includes('--stale'));
} else {
    fail('usage: reviews record <path>... [--careful | --formal]'
        + ' [--evidence <artifact>] [--by NAME]'
        + ' | declare <path> <origin> | show [--stale] | track');
}
